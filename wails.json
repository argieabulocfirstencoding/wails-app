{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "fesapp",
  "outputfilename": "FesApp Tracker",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "Paul",
    "email": "johnpaultunacao.firstencoding@gmail.com"
  },
  "info": {
    "productName": "FESApp Tracker",
    "productVersion": "2.5.0",
    "description": "An application with installer and updater enabled.",
    "companyName": "First Encoding Services",
    "copyright": "Copyright 2025 First Encoding Services",
    "signingIdentity": "My Developer Certificate"
  },
  "windows": {
    "arch": "amd64",
    "icon": "build/windows/icon.ico",
    "info": {
      "CompanyName": "First Encoding Services",
      "FileDescription": "Tracking App used by First Encoding Services",
      "ProductName": "FESApp"
    }
  },
  "options": {
    "windows": {
      "installer": {
        "name": "FESApp Tracker Setup",
        "publisher": "First Encoding Services",
        "icon": "build/windows/icon.ico",
        "setupIcon": "build/windows/icon.ico",
        "compression": "lzma",
        "unicode": true,
        "disableDirPage": false
      },
      "build": {
        "arch": "amd64"
      }
    },
    "appresults": {
      "arch": "amd64"
    },
    "upx": {
      "enabled": true
    }
  },
  "assets": {
    "files": [
      {
        "dir": "./",
        "pattern": "build/windows/icon.ico"
      }
    ]
  }
}
